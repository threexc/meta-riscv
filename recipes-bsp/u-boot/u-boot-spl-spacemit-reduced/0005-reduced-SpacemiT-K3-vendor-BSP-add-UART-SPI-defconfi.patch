+CONFIG_RESET_SPACEMIT_K3=y
+CONFIG_SYS_NS16550=y
+CONFIG_SYS_NS16550_IER=0x40
+CONFIG_SPI=y
+CONFIG_K1X_QSPI=y
+CONFIG_TIMER_EARLY=y
+CONFIG_SPL_LZO=y
