+#define SPACEMIT_K3_IRQCHIP_NUM_MSIS       511
+#define SPACEMIT_K3_IRQCHIP_NUM_SOURCES    512
+#define SPACEMIT_K3_IRQCHIP_NUM_PRIO_BITS  3
+#define SPACEMIT_K3_IMSIC_GUESTS           5
